FROM ubuntu:26.04 AS build
RUN apt-get update \
    && apt-get install -y --no-install-recommends cmake ninja-build g++ libboost-dev \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY . .
RUN cmake -S . -B /build -G Ninja -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF \
    && cmake --build /build \
    && cmake --install /build --prefix /install --strip

FROM ubuntu:26.04
COPY --from=build /install/bin/chess_server /usr/local/bin/chess_server
ENV PORT=8080
EXPOSE 8080
USER 10001:10001
CMD ["/usr/local/bin/chess_server"]
